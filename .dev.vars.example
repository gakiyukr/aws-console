# Wrangler 本機 Worker 執行期使用的敏感設定（pnpm dev:worker 用）。
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# OIDC SSO：本機同樣走真實流程，需在 IdP 註冊
# http://localhost:8787/api/auth/callback 為 redirect URI。
OIDC_ISSUER=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAILS=
