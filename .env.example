# Cloudflare Worker 與 D1 建置設定。
CLOUDFLARE_WORKER_NAME=aws-console
CLOUDFLARE_D1_DATABASE_NAME=aws-console
CLOUDFLARE_D1_DATABASE_ID=

SESSION_SECRET=
# 32 位元組 Base64 主金鑰；只可保存於 secret，不可寫入 D1。
CREDENTIAL_ENCRYPTION_KEY=

# OIDC SSO（Cloudflare Access SaaS app 或其他標準 OIDC IdP）。
# OIDC_ISSUER 指向 IdP 的 discovery；IdP 無 discovery 時改填下面三個端點。
OIDC_ISSUER=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 允許登入的 email，逗號分隔。
OIDC_ALLOWED_EMAILS=
